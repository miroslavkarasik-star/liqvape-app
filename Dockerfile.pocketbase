FROM alpine:latest

RUN apk add --no-cache wget unzip

WORKDIR /pocketbase

# Скачиваем PocketBase
RUN wget https://github.com/pocketbase/pocketbase/releases/download/v0.22.0/pocketbase_0.22.0_linux_amd64.zip && \
    unzip pocketbase_0.22.0_linux_amd64.zip && \
    rm pocketbase_0.22.0_linux_amd64.zip

# Создаём папку для данных
RUN mkdir -p /pocketbase/pb_data

# Копируем базу данных если есть
COPY pocketbase/pb_data/data.db /pocketbase/pb_data/data.db 2>/dev/null || true

EXPOSE 8090

CMD ["./pocketbase", "serve", "--http=0.0.0.0:8090"]
